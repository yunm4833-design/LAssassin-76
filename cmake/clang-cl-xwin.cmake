set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CMAKE_TRY_COMPILE_CONFIGURATION Release)
if(NOT DEFINED ENV{XWIN_ROOT} OR NOT DEFINED ENV{LLVM_ROOT} OR NOT DEFINED ENV{CLANG_CL})
    message(FATAL_ERROR "Set XWIN_ROOT, LLVM_ROOT and CLANG_CL for the host compiler and Windows SDK")
endif()
set(CMAKE_C_COMPILER "$ENV{CLANG_CL}")
set(CMAKE_CXX_COMPILER "$ENV{CLANG_CL}")
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_LINKER "$ENV{LLVM_ROOT}/bin/lld-link")
set(CMAKE_AR "$ENV{LLVM_ROOT}/bin/llvm-lib")
set(CMAKE_RC_COMPILER "$ENV{LLVM_ROOT}/bin/llvm-rc")
set(CMAKE_MT /usr/bin/true)
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded)
set(xwin "$ENV{XWIN_ROOT}")
set(win_includes "/imsvc${xwin}/crt/include /imsvc${xwin}/sdk/include/ucrt /imsvc${xwin}/sdk/include/um /imsvc${xwin}/sdk/include/shared /imsvc${xwin}/sdk/include/winrt")
set(CMAKE_C_FLAGS_INIT "${win_includes}")
set(CMAKE_CXX_FLAGS_INIT "${win_includes} /EHsc")
set(CMAKE_RC_FLAGS_INIT "/I${xwin}/sdk/include/um /I${xwin}/sdk/include/shared /I${xwin}/sdk/include/ucrt")
set(win_libs "/libpath:${xwin}/crt/lib/x86_64 /libpath:${xwin}/sdk/lib/um/x86_64 /libpath:${xwin}/sdk/lib/ucrt/x86_64 /manifest:no")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${win_libs}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${win_libs}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${win_libs}")
set(CMAKE_FIND_ROOT_PATH "${xwin}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
